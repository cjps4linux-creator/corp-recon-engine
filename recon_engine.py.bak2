# ----------------------------------------------
# GRADIO UI
# ----------------------------------------------

def create_ui():
    """Build the Gradio interface."""
    
    with gr.Blocks(
        title="Corporate Reconciliation Engine",
    ) as demo:
        
        # Header
        gr.Markdown("""
        # 🏦 Corporate Reconciliation Engine
        **Micro-SaaS Prototype** - Automated bank-to-invoice matching with fuzzy logic, discrepancy flagging, and audit-ready PDF reports.
        """)
        
        with gr.Row():
            # --- LEFT PANEL: INPUTS ---
            with gr.Column(scale=1):
                gr.Markdown("### 📁 Upload Files")
                
                bank_input = gr.File(
                    label="1. Bank Statement (CSV / Excel / PDF)",
                    file_types=[".csv", ".xlsx", ".xls", ".pdf"],
                    file_count="single"
                )
                invoice_input = gr.File(
                    label="2. Supplier Invoices (CSV / Excel / PDF)",
                    file_types=[".csv", ".xlsx", ".xls", ".pdf"],
                    file_count="single"
                )
                
                gr.Markdown("### ⚙️ Matching Parameters")
                threshold_slider = gr.Slider(
                    50, 95, value=DEFAULT_THRESHOLD, step=1,
                    label="Fuzzy Match Threshold (%)",
                    info="Lower = more matches (risk of false positives). Higher = stricter."
                )
                tolerance_slider = gr.Slider(
                    0.5, 20, value=AMOUNT_TOLERANCE * 100, step=0.5,
                    label="Amount Tolerance (%)",
                    info="Max % difference between bank outflow and invoice amount."
                )
                
                btn_run = gr.Button("🚀 Run Reconciliation", variant="primary", size="lg")
                
                with gr.Row():
                    btn_pdf = gr.Button("📄 Download PDF Report", variant="secondary")
                    btn_csv = gr.Button("📊 Download CSV Data", variant="secondary")
                
                gr.Markdown("### 📋 Quick Start")
                btn_sample = gr.Button("🇿🇦 Load SA Demo Data", variant="secondary")
                
                status_log = gr.Textbox(
                                label="Processing Status",
                                lines=6,
                                interactive=False
                            )
                
                pdf_output = gr.File(label="Generated PDF Report", interactive=False)
                csv_output = gr.File(label="Cleaned CSV Data", interactive=False)
            
            # --- RIGHT PANEL: RESULTS ---
            with gr.Column(scale=2):
                gr.Markdown("### 📊 Results Preview")
                
                with gr.Row():
                    with gr.Column():
                        matched_count = gr.Number(label="✅ Matched", value=0, interactive=False, precision=0)
                    with gr.Column():
                        unmatched_bank_count = gr.Number(label="⚠️ Unmatched (Bank)", value=0, interactive=False, precision=0)
                    with gr.Column():
                        unmatched_inv_count = gr.Number(label="📄 Unmatched (Invoice)", value=0, interactive=False, precision=0)
                    with gr.Column():
                        match_rate_box = gr.Number(label="📈 Match Rate (%)", value=0, interactive=False, precision=1)
                
                matched_df = gr.DataFrame(
                    label="Matched Transactions",
                    headers=["Date", "Bank Description", "Bank Amount", "Invoice Description", "Invoice Amount", "Score", "Category"],
                    wrap=True,
                    max_height=350
                )
                unmatched_df = gr.DataFrame(
                    label="Unmatched Items (Review Required)",
                    headers=["Type", "Date", "Description", "Amount", "Best Match", "Match Amt", "Score", "Reason"],
                    wrap=True,
                    max_height=350
                )
        
        # --- EVENT HANDLERS ---
        
        def run_recon(bank_file, inv_file, thresh, tol):
            if bank_file is None or inv_file is None:
                return (
                    "❌ Error: Please upload both Bank Statement and Invoice files.",
                    None, None,
                    gr.DataFrame(value=[]), gr.DataFrame(value=[]),
                    0, 0, 0, 0
                )
            
            status = "⏳ Loading and normalizing files..."
            results = process_reconciliation(bank_file, inv_file, int(thresh), tol / 100)
            
            if results["summary"].get("error"):
                return (
                    f"❌ Error: {results['summary']['error']}",
                    None, None,
                    gr.DataFrame(value=[]), gr.DataFrame(value=[]),
                    0, 0, 0, 0
                )
            
            # Build matched DataFrame
            matched_rows = []
            for m in results["matched_transactions"]:
                matched_rows.append([
                    m.get('bank_date', ''),
                    m.get('bank_desc', ''),
                    f"{m.get('bank_amount', 0):,.2f}",
                    m.get('inv_desc', ''),
                    f"{m.get('inv_amount', 0):,.2f}",
                    f"{m.get('match_score', 0):.0f}%",
                    m.get('category', 'Other'),
                ])
            
            # Build unmatched DataFrame (combined)
            unmatched_rows = []
            for u in results["unmatched_bank"]:
                unmatched_rows.append([
                    "Bank",
                    u.get('bank_date', ''),
                    u.get('bank_desc', ''),
                    f"{u.get('bank_amount', 0):,.2f}",
                    u.get('best_inv_match', ''),
                    f"{u.get('inv_amount', 0):,.2f}" if u.get('inv_amount') else "-",
                    f"{u.get('score', 0):.0f}%" if u.get('score') else "-",
                    u.get('reason', ''),
                ])
            for u in results["unmatched_invoices"]:
                unmatched_rows.append([
                    "Invoice",
                    u.get('inv_date', ''),
                    u.get('inv_desc', ''),
                    f"{u.get('inv_amount', 0):,.2f}",
                    "-", "-", "-",
                    u.get('status', ''),
                ])
            
            s = results["summary"]
            status_msg = (
                f"✅ Reconciliation Complete\n"
                f"   Matched: {s['matched_count']} | Unmatched Bank: {s['unmatched_bank_count']} | Unmatched Invoice: {s['unmatched_inv_count']}\n"
                f"   Match Rate: {s['match_rate']}% | Threshold: {s['threshold_used']}% | Tolerance: {s['tolerance_used']}%\n"
                f"   Generated: {s['generated_at']}"
            )
            
            return (
                status_msg,
                s["pdf_file"], s["csv_file"],
                gr.DataFrame(value=matched_rows),
                gr.DataFrame(value=unmatched_rows),
                s['matched_count'], s['unmatched_bank_count'], s['unmatched_inv_count'], s['match_rate']
            )
        
        btn_run.click(
            fn=run_recon,
            inputs=[bank_input, invoice_input, threshold_slider, tolerance_slider],
            outputs=[status_log, pdf_output, csv_output, matched_df, unmatched_df,
                     matched_count, unmatched_bank_count, unmatched_inv_count, match_rate_box]
        )
        
        def load_sample():
            bank_path, inv_path = generate_sample_data()
            # Return file objects that Gradio can use
            return (
                gr.File(value=bank_path),
                gr.File(value=inv_path),
                "✅ SA Demo data loaded. Click 'Run Reconciliation' to process."
            )
        
        btn_sample.click(
            fn=load_sample,
            inputs=[],
            outputs=[bank_input, invoice_input, status_log]
        )
        
        # Download buttons just return the file paths already generated
        btn_pdf.click(lambda x: x, inputs=[pdf_output], outputs=[pdf_output])
        btn_csv.click(lambda x: x, inputs=[csv_output], outputs=[csv_output])
        
        # Footer
        gr.Markdown("""
        ---
        **Corporate Reconciliation Engine v1.0** | Built with Gradio, rapidfuzz, fpdf2 | 
        *For demo purposes - verify all matches before financial close*
        """)
    
    return demo


# ----------------------------------------------
# ENTRY POINT
