from pdf_extractor import process_pdf, PDFExtractionError
from vendor_normalizer import normalize_description_for_matching, normalize_vendor_name
from vendor_aliases import get_canonical_name

# ----------------------------------------------
# CONSTANTS & CONFIGURATION
# ----------------------------------------------

# Color palette (Kimi3/Fable 5 inspired corporate)
NAVY      = "#1B365D"
GOLD      = "#C5A059"
WHITE     = "#FFFFFF"
LIGHT_GRAY= "#F3F4F6"
MID_GRAY  = "#E5E7EB"
DARK_GRAY = "#1F2937"
MED_GRAY  = "#6B7280"
GREEN_BG  = "#D1FAE5"
GREEN_TXT = "#065F46"
AMBER_BG  = "#FEF3C7"
AMBER_TXT = "#92400E"
RED_BG    = "#FEE2E2"
RED_TXT   = "#991B1B"

# Company branding (change per client)
COMPANY_NAME = "Nexus Digital Solutions (Pty) Ltd"

# Rule-based categorization (expandable)
CATEGORY_MAP = {
    "acme": "Professional Services",
    "uber": "Transportation",
    "shell": "Auto & Fuel",
    "starbucks": "Meals & Entertainment",
    "amazon": "Cloud & Software",
    "netflix": "Subscriptions",
    "quickbooks": "Accounting Software",
    "microsoft": "Cloud & Software",
    "mtn": "Telecommunications",
    "vodacom": "Telecommunications",
    "telkom": "Telecommunications",
    "woolworths": "Retail & Supplies",
    "pick n pay": "Retail & Supplies",
    "shoprite": "Retail & Supplies",
    "eskom": "Utilities",
    "sasol": "Energy & Fuel",
    "engeng": "Auto & Fuel",
    "standard bank": "Banking & Finance",
    "absa": "Banking & Finance",
    "fnb": "Banking & Finance",
    "nedbank": "Banking & Finance",
    "nando's": "Meals & Entertainment",
}

DEFAULT_THRESHOLD = 75
AMOUNT_TOLERANCE = 0.05  # 5%


# ----------------------------------------------
# HELPER FUNCTIONS
# ----------------------------------------------

def clean_string(s: Any) -> str:
    """Normalize string for fuzzy matching."""
    if pd.isna(s):
        return ""
    return str(s).strip().lower()


def detect_description_column(df: pd.DataFrame, is_bank: bool = True) -> str:
    """Find the best description column — uses substring matching for PDF columns."""
    if is_bank:
        candidates = ['description', 'name', 'ref', 'memo', 'payee', 'transaction', 'details', 'narrative', 'particulars']
    else:
        candidates = [
            'vendor name', 'vendor', 'supplier name', 'supplier', 'payee name', 'payee',
            'description', 'name', 'ref', 'memo', 'details', 'particulars'
        ]
    
    cols_lower = df.columns.str.lower().str.strip()
    
    # Pass 1: exact match
    for cand in candidates:
        matches = cols_lower[cols_lower == cand]
        if len(matches) > 0:
            return df.columns[cols_lower == cand][0]
    
    # Pass 2: substring match
    for cand in candidates:
        matches = cols_lower[cols_lower.str.contains(cand, na=False)]
        if len(matches) > 0:
            return matches.iloc[0]
    
    # Fallback: first non-date, non-amount column
    for col in df.columns:
        cl = col.lower()
        if cl not in ('date', 'amount', 'value', 'debit', 'credit', 'balance', 'type',
                       'invoice', 'payment', 'invoice number', 'invoice no', 'inv no',
                       'inv #', 'reference', 'ref', 'due date', 'invoice date',
                       'tax amount', 'tax', 'currency', 'status', 'category', 'bank',
                       'txn date', 'transaction date', '_page'):
            return col
    return df.columns[0]


def detect_amount_column(df: pd.DataFrame) -> str:
    """Find the amount column — uses substring matching for PDF-extracted columns."""
    cols_lower = df.columns.str.lower().str.strip()
    
    # Pass 1: exact match on transaction-amount keywords (NOT balance — that's a running total)
    tier1 = ['amount', 'value', 'debit', 'credit', 'total', 'paid', 'payable']
    for cand in tier1:
        matches = cols_lower[cols_lower == cand]
        if len(matches) > 0:
            return df.columns[cols_lower == cand][0]
    
    # Pass 2: substring match (handles "Amount (USD)", "Debit (ZAR)", "Amount (ZAR)", etc.)
    for cand in tier1:
        mask = cols_lower.str.contains(cand, na=False)
        if mask.any():
            return df.columns[mask][0]
    
    # Pass 3: balance only as last resort (running total — better than nothing)
    mask = cols_lower.str.contains('balance', na=False)
    if mask.any():
        return df.columns[mask][0]
    
    # Pass 4: numeric column fallback — exclude _page and other metadata
    for col in df.columns:
        if col.startswith('_'):
            continue
        if pd.api.types.is_numeric_dtype(df[col]):
            sample = df[col].dropna().head(10)
            if len(sample) > 0:
                mean_val = sample.mean()
                if mean_val > 0 and mean_val < 1e9:
                    return col
    return df.columns[-1]


def detect_date_column(df: pd.DataFrame) -> Optional[str]:
    """Find the date column."""
    candidates = ['date', 'transaction date', 'txn date', 'posted date', 'invoice date', 'due date']
    cols_lower = df.columns.str.lower().str.strip()
    for cand in candidates:
        matches = cols_lower[cols_lower == cand]
        if len(matches) > 0:
            return df.columns[cols_lower == cand][0]
    return None


def categorize(description: str) -> str:
    """Simple rule-based categorization."""
    desc = description.lower()
    for keyword, category in CATEGORY_MAP.items():
        if keyword in desc:
            return category
    return "Other"


def parse_amount(val: Any) -> float:
    """Safely parse amount to float — handles currency symbols, commas, parentheses, suffixes."""
    if pd.isna(val):
        return 0.0
    if isinstance(val, (int, float)):
        return float(val)
    # Handle strings with currency symbols, commas, parentheses
    s = str(val).strip()
    # Remove common currency symbols and whitespace
    s = re.sub(r'[R$€£\s]', '', s)
    # Remove parenthetical amounts (accounting negative)
    if s.startswith('(') and s.endswith(')'):
        s = '-' + s[1:-1]
    # Remove commas
    s = s.replace(',', '')
    try:
        return float(s)
    except ValueError:
        return 0.0


# ----------------------------------------------
# CORE RECONCILIATION LOGIC
# ----------------------------------------------

def process_reconciliation(
    bank_file,
    invoice_file,
    threshold: int = DEFAULT_THRESHOLD,
    amount_tolerance: float = AMOUNT_TOLERANCE
) -> Dict[str, Any]:
    """
    Core reconciliation pipeline:
    1. Load & normalize bank & invoice data
    2. Multi-strategy fuzzy match descriptions + amount tolerance
    3. Categorize matches
    4. Produce structured results + CSV + PDF
    """
    results = {
        "matched_transactions": [],
        "unmatched_bank": [],
        "unmatched_invoices": [],
        "summary": {},
        "csv_file": None,
        "pdf_file": None,
    }

    # -- Load Files ----------------------------
    bank_df = None
    invoice_df = None
    errors = []

    def load_file(file_obj, file_type: str) -> Optional[pd.DataFrame]:
        if file_obj is None:
            return None
        try:
            name = file_obj.name.lower()
            if name.endswith('.csv'):
                return pd.read_csv(file_obj.name)
            elif name.endswith(('.xlsx', '.xls')):
                return pd.read_excel(file_obj.name)
            elif name.endswith('.pdf'):
                # Extract data from PDF
                pdf_result = process_pdf(file_obj.name)
                if not pdf_result['success']:
                    errors.append(f"{file_type}: {pdf_result['message']}")
                    return None
                return pdf_result['data']
            else:
                errors.append(f"{file_type}: Unsupported file format. Use CSV, Excel, or PDF.")
                return None
        except Exception as e:
            errors.append(f"{file_type}: {str(e)}")
            return None

    bank_df = load_file(bank_file, "Bank")
    invoice_df = load_file(invoice_file, "Invoice")

    if errors:
        results["summary"]["error"] = "; ".join(errors)
        return results

    if bank_df is None or invoice_df is None:
        results["summary"]["error"] = "Please upload both a Bank Statement and an Invoice file."
        return results

    # -- Normalize Columns --------------------
    bank_desc_col = detect_description_column(bank_df, is_bank=True)
    bank_amt_col = detect_amount_column(bank_df)
    bank_date_col = detect_date_column(bank_df)

    inv_desc_col = detect_description_column(invoice_df, is_bank=False)
    inv_amt_col = detect_amount_column(invoice_df)
    inv_date_col = detect_date_column(invoice_df)

    # Build clean working frames
    bank_work = pd.DataFrame({
        'orig_desc': bank_df[bank_desc_col],
        'desc_clean': bank_df[bank_desc_col].apply(clean_string),
        'amount': bank_df[bank_amt_col].apply(parse_amount),
        'date': bank_df[bank_date_col] if bank_date_col else '',
        '_orig_idx': range(len(bank_df)),
    })
    bank_work = bank_work[bank_work['desc_clean'] != ''].reset_index(drop=True)

    inv_work = pd.DataFrame({
        'orig_desc': invoice_df[inv_desc_col],
        'desc_clean': invoice_df[inv_desc_col].apply(clean_string),
        'amount': invoice_df[inv_amt_col].apply(parse_amount),
        'date': invoice_df[inv_date_col] if inv_date_col else '',
        '_orig_idx': range(len(invoice_df)),
    })
    inv_work = inv_work[inv_work['desc_clean'] != ''].reset_index(drop=True)

    if bank_work.empty or inv_work.empty:
        results["summary"]["error"] = "No valid data rows after cleaning."
        return results

    # -- Filter Noise Rows ---------------------
    noise_keywords = ['opening balance', 'closing balance', 'total', 'subtotal',
                      'balance brought forward', 'balance carried forward']

    bank_work = bank_work[~bank_work['desc_clean'].str.lower().isin(noise_keywords)].reset_index(drop=True)
    inv_work = inv_work[~inv_work['desc_clean'].str.lower().isin(noise_keywords)].reset_index(drop=True)

    if bank_work.empty or inv_work.empty:
        results["summary"]["error"] = "No valid data rows after filtering noise."
        return results

    # -- Deduplicate bank rows ----------------------------------------
    # Keep first occurrence of each (description, amount) pair so that
    # duplicate bank entries do not consume multiple invoice matches.
    bank_work = bank_work.drop_duplicates(subset=['desc_clean', 'amount'], keep='first').reset_index(drop=True)

    # -- Pre-compute normalization for matching --
    bank_work['desc_normalized'] = bank_work['desc_clean'].apply(normalize_description_for_matching)
    inv_work['desc_normalized'] = inv_work['desc_clean'].apply(normalize_vendor_name)
    bank_work['desc_canonical'] = bank_work['orig_desc'].apply(get_canonical_name)
    inv_work['desc_canonical'] = inv_work['orig_desc'].apply(get_canonical_name)

    # Build canonical name index for fast lookup
    inv_canonical_index = {}
    for inv_idx, inv_row in inv_work.iterrows():
        canonical = inv_row['desc_canonical']
        if canonical and canonical not in inv_canonical_index:
            inv_canonical_index[canonical] = inv_idx

    # Precompute invoice lists for fuzzy matching
    inv_norm_list = inv_work['desc_normalized'].tolist()
    inv_clean_list = inv_work['desc_clean'].tolist()

    matched_invoice_indices = set()

    for b_idx, b_row in bank_work.iterrows():
        bank_desc = b_row['desc_clean']
        bank_desc_norm = b_row['desc_normalized']
        bank_desc_canonical = b_row['desc_canonical']
        bank_amt = b_row['amount']
        bank_orig = b_row['orig_desc']
        bank_date = b_row['date']

        if not bank_desc:
            continue

        best_score = 0
        best_inv_idx = -1
        best_match_desc = ""
        best_match_amt = 0.0
        best_reason = "Low Description Match"

        # Strategy 1: Canonical name exact match
        if bank_desc_canonical and bank_desc_canonical in inv_canonical_index:
            inv_idx = inv_canonical_index[bank_desc_canonical]
            if inv_idx not in matched_invoice_indices:
                best_score = 100
                best_inv_idx = inv_idx
                best_match_desc = inv_work.iloc[inv_idx]['desc_clean']
                best_match_amt = inv_work.iloc[inv_idx]['amount']
                best_reason = "Canonical Match"

        # Strategy 2: Token-set ratio (handles word-order swaps, extra words)
        if best_inv_idx == -1 and bank_desc_norm and len(bank_desc_norm) > 2:
            best_token = process.extractOne(
                bank_desc_norm,
                inv_norm_list,
                scorer=fuzz.token_set_ratio,
                score_cutoff=threshold - 10  # Slightly lower for token-set
            )
            if best_token:
                _, score, inv_idx = best_token
                if score > best_score:
                    best_score = score
                    best_inv_idx = inv_idx
                    best_match_desc = inv_work.iloc[inv_idx]['desc_clean']
                    best_match_amt = inv_work.iloc[inv_idx]['amount']
                    best_reason = "Token Set Match"

        # Strategy 3: Normalized WRatio
        if best_inv_idx == -1 and bank_desc_norm and len(bank_desc_norm) > 2:
            best_norm = process.extractOne(
                bank_desc_norm,
                inv_norm_list,
                scorer=fuzz.WRatio,
                score_cutoff=threshold
            )
            if best_norm:
                _, score, inv_idx = best_norm
                if score > best_score:
                    best_score = score
                    best_inv_idx = inv_idx
                    best_match_desc = inv_work.iloc[inv_idx]['desc_clean']
                    best_match_amt = inv_work.iloc[inv_idx]['amount']
                    best_reason = "Normalized WRatio"

        # Strategy 4: Partial ratio (handles abbreviations like "AWS" vs "Amazon Web Services")
        if best_inv_idx == -1 and len(bank_desc) > 2:
            best_partial = process.extractOne(
                bank_desc,
                inv_clean_list,
                scorer=fuzz.partial_ratio,
                score_cutoff=threshold + 10  # Partial is stricter
            )
            if best_partial:
                _, score, inv_idx = best_partial
                if score > best_score:
                    best_score = score
                    best_inv_idx = inv_idx
                    best_match_desc = inv_work.iloc[inv_idx]['desc_clean']
                    best_match_amt = inv_work.iloc[inv_idx]['amount']
                    best_reason = "Partial Match"

        # Strategy 5: Raw WRatio fallback
        if best_inv_idx == -1:
            best_orig = process.extractOne(
                bank_desc,
                inv_clean_list,
                scorer=fuzz.WRatio,
                score_cutoff=max(threshold - 5, 60)  # Fallback threshold
            )
            if best_orig:
                _, score, inv_idx = best_orig
                if score > best_score:
                    best_score = score
                    best_inv_idx = inv_idx
                    best_match_desc = inv_work.iloc[inv_idx]['desc_clean']
                    best_match_amt = inv_work.iloc[inv_idx]['amount']
                    best_reason = "Raw Fuzzy"

        if best_inv_idx == -1:
            results["unmatched_bank"].append({
                "bank_date": bank_date,
                "bank_desc": bank_orig,
                "bank_amount": bank_amt,
                "best_inv_match": None,
                "score": 0,
                "inv_amount": None,
                "reason": "Low Description Match"
            })
            continue

        matched_desc = best_match_desc
        inv_amt = best_match_amt
        inv_orig = inv_work.iloc[best_inv_idx]['orig_desc']

        if best_inv_idx in matched_invoice_indices:
            results["unmatched_bank"].append({
                "bank_date": bank_date,
                "bank_desc": bank_orig,
                "bank_amount": bank_amt,
                "best_inv_match": matched_desc,
                "score": best_score,
                "inv_amount": inv_amt,
                "reason": "Invoice Already Matched"
            })
            continue

        # Amount tolerance: compare absolute values and allow sign differences.
        # Bank debits are often negative while invoices show positive amounts.
        amt_diff = abs(abs(bank_amt) - abs(inv_amt))
        denom = max(abs(inv_amt), 0.01)
        amt_ok = (amt_diff / denom) < amount_tolerance

        if amt_ok:
            results["matched_transactions"].append({
                "bank_date": bank_date,
                "bank_desc": bank_orig,
                "bank_amount": bank_amt,
                "inv_desc": inv_orig,
                "inv_amount": inv_amt,
                "match_score": best_score,
                "status": "Matched",
                "category": categorize(bank_orig),
                "match_method": best_reason,
            })
            matched_invoice_indices.add(best_inv_idx)
        else:
            results["unmatched_bank"].append({
                "bank_date": bank_date,
                "bank_desc": bank_orig,
                "bank_amount": bank_amt,
                "best_inv_match": matched_desc,
                "score": best_score,
                "inv_amount": inv_amt,
                "reason": "Amount Mismatch"
            })

    # Unmatched invoices (not matched to any bank row)
    for inv_idx, inv_row in inv_work.iterrows():
        if inv_idx not in matched_invoice_indices:
            results["unmatched_invoices"].append({
                "inv_date": inv_row['date'],
                "inv_desc": inv_row['orig_desc'],
                "inv_amount": inv_row['amount'],
                "status": "Unmatched (No Bank Entry)"
            })
        else:
            results["unmatched_bank"].append({
                "bank_date": bank_date,
                "bank_desc": bank_orig,
                "bank_amount": bank_amt,
                "best_inv_match": matched_desc,
                "score": best_score,
                "inv_amount": inv_amt,
                "reason": "Amount Mismatch"
            })

    # Unmatched invoices (not matched to any bank row)
    for inv_idx, inv_row in inv_work.iterrows():
        if inv_idx not in matched_invoice_indices:
            results["unmatched_invoices"].append({
                "inv_date": inv_row['date'],
                "inv_desc": inv_row['orig_desc'],
                "inv_amount": inv_row['amount'],
                "status": "Unmatched (No Bank Entry)"
            })

    # -- Generate CSV -------------------------
    csv_path = f"recon_data_{datetime.now().strftime('%Y%m%d_%H%M%S')}.csv"
    export_rows = []
    for m in results["matched_transactions"]:
        export_rows.append({
            "Type": "Matched",
            "Date": m["bank_date"],
            "Bank Description": m["bank_desc"],
            "Bank Amount": m["bank_amount"],
            "Invoice Description": m["inv_desc"],
            "Invoice Amount": m["inv_amount"],
            "Match Score": m["match_score"],
            "Category": m["category"],
            "Status": m["status"],
            "Reason": "",
        })
    for u in results["unmatched_bank"]:
        export_rows.append({
            "Type": "Unmatched Bank",
            "Date": u["bank_date"],
            "Bank Description": u["bank_desc"],
            "Bank Amount": u["bank_amount"],
            "Invoice Description": u["best_inv_match"] or "",
            "Invoice Amount": u["inv_amount"] or "",
            "Match Score": u["score"],
            "Category": "",
            "Status": "Unmatched",
            "Reason": u["reason"],
        })
    for u in results["unmatched_invoices"]:
        export_rows.append({
            "Type": "Unmatched Invoice",
            "Date": u["inv_date"],
            "Bank Description": "",
            "Bank Amount": "",
            "Invoice Description": u["inv_desc"],
            "Invoice Amount": u["inv_amount"],
            "Match Score": "",
            "Category": "",
            "Status": "Unmatched",
            "Reason": u["status"],
        })
    pd.DataFrame(export_rows).to_csv(csv_path, index=False)
    results["csv_file"] = csv_path

    # -- Summary -----------------------------
    results["summary"] = {
            "matched_count": len(results["matched_transactions"]),
            "unmatched_bank_count": len(results["unmatched_bank"]),
            "unmatched_inv_count": len(results["unmatched_invoices"]),
            "total_bank": len(bank_work),
            "total_invoice": len(inv_work),
            "match_rate": round(len(results["matched_transactions"]) / max(len(bank_work), 1) * 100, 1),
            "pdf_file": None,  # Will be set after PDF generation
            "csv_file": csv_path,
            "threshold_used": threshold,
            "tolerance_used": round(amount_tolerance * 100, 1),
            "generated_at": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
        }

    # -- Generate PDF -------------------------
    from report_generator import generate_report
    pdf_path = generate_report(results, company_name=COMPANY_NAME)
    results["pdf_file"] = pdf_path
    results["summary"]["pdf_file"] = pdf_path

    return results


# ----------------------------------------------
# PROFESSIONAL PDF GENERATOR (Kimi3 / Fable 5 Style)
# ----------------------------------------------

class ReconciliationPDF(FPDF):
    """Professional reconciliation report with modern corporate aesthetic."""
    
    def __init__(self):
        super().__init__('P', 'mm', 'A4')
        self.set_auto_page_break(auto=True, margin=25)
        self.matched_data = []
        self.unmatched_bank = []
        self.unmatched_inv = []
        self.summary = {}
        self.company_name = "Hermes Reconciliation Engine"
        
    def header(self):
        if self.page_no() == 1:
            return  # Cover page handled separately
        # Navy header bar
        self.set_fill_color(int(NAVY[1:3], 16), int(NAVY[3:5], 16), int(NAVY[5:7], 16))
        self.rect(0, 0, 210, 14, 'F')
        self.set_text_color(255, 255, 255)
        self.set_font("Helvetica", "B", 9)
        self.set_xy(10, 4)
        self.cell(90, 6, f"  {self.company_name} - Reconciliation Report", 0, 0, 'L')
        self.set_font("Helvetica", "", 8)
        self.cell(90, 6, f"Confidential  |  Page {self.page_no()}", 0, 1, 'R')
        self.set_draw_color(int(GOLD[1:3], 16), int(GOLD[3:5], 16), int(GOLD[5:7], 16))
        self.set_line_width(0.5)
        self.line(10, 14, 200, 14)
        self.ln(4)
        
    def footer(self):
        self.set_y(-18)
        self.set_draw_color(int(MID_GRAY[1:3], 16), int(MID_GRAY[3:5], 16), int(MID_GRAY[5:7], 16))
        self.set_line_width(0.3)
        self.line(10, self.get_y(), 200, self.get_y())
        self.ln(2)
        self.set_font("Helvetica", "I", 7)
        self.set_text_color(int(MED_GRAY[1:3], 16), int(MED_GRAY[3:5], 16), int(MED_GRAY[5:7], 16))
        self.cell(0, 4, f"Generated: {self.summary.get('generated_at', '')}  |  Threshold: {self.summary.get('threshold_used', '')}%  |  Tolerance: {self.summary.get('tolerance_used', '')}%", 0, 0, 'C')

    def section_title(self, title: str, icon: str = ""):
        self.ln(2)
        self.set_fill_color(int(NAVY[1:3], 16), int(NAVY[3:5], 16), int(NAVY[5:7], 16))
        self.rect(10, self.get_y(), 190, 10, 'F')
        self.set_text_color(255, 255, 255)
        self.set_font("Helvetica", "B", 10)
        self.set_xy(14, self.get_y() + 2)
        self.cell(180, 6, f"  {title}", 0, 1, 'L')
        self.set_draw_color(int(GOLD[1:3], 16), int(GOLD[3:5], 16), int(GOLD[5:7], 16))
        self.set_line_width(0.6)
        self.line(10, self.get_y(), 200, self.get_y())
        self.set_text_color(int(DARK_GRAY[1:3], 16), int(DARK_GRAY[3:5], 16), int(DARK_GRAY[5:7], 16))
        self.ln(3)

    def metric_card(self, label: str, value: str, bg_color: str, txt_color: str, x: float, w: float):
        r, g, b = int(bg_color[1:3], 16), int(bg_color[3:5], 16), int(bg_color[5:7], 16)
        tr, tg, tb = int(txt_color[1:3], 16), int(txt_color[3:5], 16), int(txt_color[5:7], 16)
        y = self.get_y()
        self.set_fill_color(r, g, b)
        self.rect(x, y, w, 22, 'F')
        self.set_text_color(tr, tg, tb)
        self.set_font("Helvetica", "B", 14)
        self.set_xy(x, y + 2)
        self.cell(w, 8, value, 0, 1, 'C')
        self.set_font("Helvetica", "", 8)
        self.set_xy(x, y + 12)
        self.cell(w, 5, label, 0, 0, 'C')
        self.set_text_color(int(DARK_GRAY[1:3], 16), int(DARK_GRAY[3:5], 16), int(DARK_GRAY[5:7], 16))
        self.set_xy(10, y + 26)

    def draw_table(self, headers: List[str], rows: List[List[str]], col_widths: List[float], 
                   header_color: str = NAVY, alt_row_color: str = LIGHT_GRAY,
                   status_col: int = -1, amount_cols: List[int] = None):
        if not rows:
            self.set_font("Helvetica", "I", 9)
            self.set_text_color(int(MED_GRAY[1:3], 16), int(MED_GRAY[3:5], 16), int(MED_GRAY[5:7], 16))
            self.cell(0, 8, "  No records in this section.", 0, 1, 'L')
            self.set_text_color(int(DARK_GRAY[1:3], 16), int(DARK_GRAY[3:5], 16), int(DARK_GRAY[5:7], 16))
            return

        # Header
        r, g, b = int(header_color[1:3], 16), int(header_color[3:5], 16), int(header_color[5:7], 16)
        self.set_fill_color(r, g, b)
        self.set_text_color(255, 255, 255)
        self.set_font("Helvetica", "B", 7.5)
        for i, h in enumerate(headers):
            self.cell(col_widths[i], 7, f" {h}", 0, 0, 'L', True)
        self.ln()
        
        # Rows
        self.set_font("Helvetica", "", 7.5)
        ar, ag, ab = int(alt_row_color[1:3], 16), int(alt_row_color[3:5], 16), int(alt_row_color[5:7], 16)
        for ri, row in enumerate(rows):
            if ri % 2 == 1:
                self.set_fill_color(ar, ag, ab)
                fill = True
            else:
                self.set_fill_color(255, 255, 255)
                fill = True
            self.set_text_color(int(DARK_GRAY[1:3], 16), int(DARK_GRAY[3:5], 16), int(DARK_GRAY[5:7], 16))
            
            # Check page break
            if self.get_y() > 260:
                self.add_page()
                # Redraw header
                self.set_fill_color(r, g, b)
                self.set_text_color(255, 255, 255)
                self.set_font("Helvetica", "B", 7.5)
                for i, h in enumerate(headers):
                    self.cell(col_widths[i], 7, f" {h}", 0, 0, 'L', True)
                self.ln()
                self.set_font("Helvetica", "", 7.5)
                self.set_text_color(int(DARK_GRAY[1:3], 16), int(DARK_GRAY[3:5], 16), int(DARK_GRAY[5:7], 16))
            
            for ci, cell in enumerate(row):
                align = 'R' if amount_cols and ci in amount_cols else 'L'
                # Truncate long text
                text = str(cell)
                max_chars = int(col_widths[ci] / 1.8)
                if len(text) > max_chars:
                    text = text[:max_chars-3] + "..."
                # Status column coloring
                if ci == status_col and status_col >= 0:
                    cell_lower = str(cell).lower()
                    if 'matched' in cell_lower or 'ok' in cell_lower:
                        self.set_text_color(int(GREEN_TXT[1:3], 16), int(GREEN_TXT[3:5], 16), int(GREEN_TXT[5:7], 16))
                    elif 'mismatch' in cell_lower or 'unmatched' in cell_lower or 'error' in cell_lower:
                        self.set_text_color(int(RED_TXT[1:3], 16), int(RED_TXT[3:5], 16), int(RED_TXT[5:7], 16))
                    elif 'amount' in cell_lower:
                        self.set_text_color(int(AMBER_TXT[1:3], 16), int(AMBER_TXT[3:5], 16), int(AMBER_TXT[5:7], 16))
                
                self.cell(col_widths[ci], 6, f" {text}", 0, 0, align, fill)
                self.set_text_color(int(DARK_GRAY[1:3], 16), int(DARK_GRAY[3:5], 16), int(DARK_GRAY[5:7], 16))
            self.ln()

    def build_cover(self, summary: Dict):
        self.add_page()
        # Full navy background
        self.set_fill_color(int(NAVY[1:3], 16), int(NAVY[3:5], 16), int(NAVY[5:7], 16))
        self.rect(0, 0, 210, 297, 'F')
        
        # Gold accent line
        self.set_draw_color(int(GOLD[1:3], 16), int(GOLD[3:5], 16), int(GOLD[5:7], 16))
        self.set_line_width(2)
        self.line(30, 60, 180, 60)
        
        # Title
        self.set_text_color(255, 255, 255)
        self.set_font("Helvetica", "B", 28)
        self.set_xy(30, 70)
        self.cell(150, 16, "Reconciliation Report", 0, 1, 'C')
        
        # Subtitle
        self.set_font("Helvetica", "", 13)
        self.set_text_color(int(GOLD[1:3], 16), int(GOLD[3:5], 16), int(GOLD[5:7], 16))
        self.set_xy(30, 90)
        self.cell(150, 8, f"Bank Statement vs. Supplier Invoices", 0, 1, 'C')
        
        # Date
        self.set_font("Helvetica", "", 11)
        self.set_text_color(200, 200, 200)
        self.set_xy(30, 110)
        self.cell(150, 7, f"Generated: {summary.get('generated_at', '')}", 0, 1, 'C')
        
        # Company
        self.set_font("Helvetica", "I", 10)
        self.set_xy(30, 125)
        self.cell(150, 6, self.company_name, 0, 1, 'C')
        
        # Gold line
        self.set_draw_color(int(GOLD[1:3], 16), int(GOLD[3:5], 16), int(GOLD[5:7], 16))
        self.set_line_width(2)
        self.line(30, 145, 180, 145)
        
        # Summary metrics on cover
        self.set_y(160)
        self.metric_card("Matched", str(summary.get('matched_count', 0)), GREEN_BG, GREEN_TXT, 30, 50)
        self.metric_card("Unmatched (Bank)", str(summary.get('unmatched_bank_count', 0)), AMBER_BG, AMBER_TXT, 85, 50)
        self.metric_card("Unmatched (Inv)", str(summary.get('unmatched_inv_count', 0)), RED_BG, RED_TXT, 140, 50)
        
        self.set_y(210)
        self.set_font("Helvetica", "", 9)
        self.set_text_color(180, 180, 180)
        self.cell(150, 6, f"Match Rate: {summary.get('match_rate', 0)}%  |  Threshold: {summary.get('threshold_used', '')}%  |  Tolerance: {summary.get('tolerance_used', '')}%", 0, 1, 'C')
        
        # Confidential notice
        self.set_y(260)
        self.set_font("Helvetica", "I", 7)
        self.cell(150, 5, "CONFIDENTIAL - For Internal Use Only", 0, 1, 'C')


def generate_professional_pdf(results: Dict) -> str:
    """Generate the professional PDF report."""
    pdf = ReconciliationPDF()
    pdf.matched_data = results["matched_transactions"]
    pdf.unmatched_bank = results["unmatched_bank"]
    pdf.unmatched_inv = results["unmatched_invoices"]
    pdf.summary = results["summary"]
    
    # Cover page
    pdf.build_cover(results["summary"])
    
    # Executive Summary (page 2)
    pdf.add_page()
    pdf.section_title("Executive Summary")
    
    pdf.set_font("Helvetica", "", 9)
    pdf.set_text_color(int(DARK_GRAY[1:3], 16), int(DARK_GRAY[3:5], 16), int(DARK_GRAY[5:7], 16))
    pdf.multi_cell(0, 5, 
        f"This report presents the reconciliation between {results['summary']['total_bank']} bank transactions "
        f"and {results['summary']['total_invoice']} supplier invoices. "
        f"Matching was performed using fuzzy string comparison (WRatio scorer) with a "
        f"{results['summary']['threshold_used']}% similarity threshold and "
        f"{results['summary']['tolerance_used']}% amount tolerance. "
        f"All amounts are shown in their original currency (negative = outflows)."
    )
    pdf.ln(4)
    
    # Metric cards row
    y_start = pdf.get_y()
    pdf.metric_card("Total Bank Items", str(results['summary']['total_bank']), NAVY, WHITE, 10, 60)
    pdf.metric_card("Total Invoices", str(results['summary']['total_invoice']), NAVY, WHITE, 75, 60)
    pdf.metric_card("Match Rate", f"{results['summary']['match_rate']}%", 
                    GREEN_BG if results['summary']['match_rate'] >= 80 else AMBER_BG,
                    GREEN_TXT if results['summary']['match_rate'] >= 80 else AMBER_TXT, 140, 60)
    pdf.set_y(y_start + 30)
    
    # -- Matched Transactions ----------------
    pdf.section_title("Matched Transactions")
    
    if pdf.matched_data:
        m_headers = ["Date", "Bank Description", "Bank Amt", "Invoice Description", "Inv Amt", "Score", "Category"]
        m_widths = [22, 38, 20, 38, 20, 14, 28]
        m_rows = []
        for m in pdf.matched_data:
            m_rows.append([
                str(m.get('bank_date', ''))[:10],
                str(m.get('bank_desc', ''))[:30],
                f"{m.get('bank_amount', 0):,.2f}",
                str(m.get('inv_desc', ''))[:30],
                f"{m.get('inv_amount', 0):,.2f}",
                f"{m.get('match_score', 0):.0f}%",
                str(m.get('category', 'Other'))[:20],
            ])
        pdf.draw_table(m_headers, m_rows, m_widths, amount_cols=[2, 4])
    else:
        pdf.set_font("Helvetica", "I", 9)
        pdf.set_text_color(int(MED_GRAY[1:3], 16), int(MED_GRAY[3:5], 16), int(MED_GRAY[5:7], 16))
        pdf.cell(0, 8, "  No matched transactions.", 0, 1, 'L')
        pdf.set_text_color(int(DARK_GRAY[1:3], 16), int(DARK_GRAY[3:5], 16), int(DARK_GRAY[5:7], 16))
    
    # -- Unmatched Bank ---------------------
    pdf.section_title("Unmatched Bank Transactions")
    
    if pdf.unmatched_bank:
        u_headers = ["Date", "Bank Description", "Bank Amt", "Best Match", "Match Amt", "Score", "Reason"]
        u_widths = [22, 38, 20, 38, 20, 14, 28]
        u_rows = []
        for u in pdf.unmatched_bank:
            u_rows.append([
                str(u.get('bank_date', ''))[:10],
                str(u.get('bank_desc', ''))[:30],
                f"{u.get('bank_amount', 0):,.2f}",
                str(u.get('best_inv_match', ''))[:30],
                f"{u.get('inv_amount', 0):,.2f}" if u.get('inv_amount') else "-",
                f"{u.get('score', 0):.0f}%" if u.get('score') else "-",
                str(u.get('reason', ''))[:25],
            ])
        pdf.draw_table(u_headers, u_rows, u_widths, amount_cols=[2, 4], status_col=6)
    else:
        pdf.set_font("Helvetica", "I", 9)
        pdf.set_text_color(int(MED_GRAY[1:3], 16), int(MED_GRAY[3:5], 16), int(MED_GRAY[5:7], 16))
        pdf.cell(0, 8, "  All bank transactions matched.", 0, 1, 'L')
        pdf.set_text_color(int(DARK_GRAY[1:3], 16), int(DARK_GRAY[3:5], 16), int(DARK_GRAY[5:7], 16))
    
    # -- Unmatched Invoices ------------------
    pdf.section_title("Unmatched Invoices (No Bank Entry)")
    
    if pdf.unmatched_inv:
        i_headers = ["Date", "Invoice Description", "Amount", "Status"]
        i_widths = [22, 70, 30, 58]
        i_rows = []
        for u in pdf.unmatched_inv:
            i_rows.append([
                str(u.get('inv_date', ''))[:10],
                str(u.get('inv_desc', ''))[:55],
                f"{u.get('inv_amount', 0):,.2f}",
                str(u.get('status', ''))[:45],
            ])
        pdf.draw_table(i_headers, i_rows, i_widths, amount_cols=[2], status_col=3)
    else:
        pdf.set_font("Helvetica", "I", 9)
        pdf.set_text_color(int(MED_GRAY[1:3], 16), int(MED_GRAY[3:5], 16), int(MED_GRAY[5:7], 16))
        pdf.cell(0, 8, "  All invoices matched to bank entries.", 0, 1, 'L')
        pdf.set_text_color(int(DARK_GRAY[1:3], 16), int(DARK_GRAY[3:5], 16), int(DARK_GRAY[5:7], 16))
    
    # -- Methodology & Notes -----------------
    pdf.add_page()
    pdf.section_title("Methodology & Notes")
    
    pdf.set_font("Helvetica", "", 9)
    pdf.set_text_color(int(DARK_GRAY[1:3], 16), int(DARK_GRAY[3:5], 16), int(DARK_GRAY[5:7], 16))
    notes = [
        "1. Matching Algorithm: Fuzzy string matching (rapidfuzz WRatio) on normalized descriptions "
        "(lowercase, stripped). Best match per bank transaction is selected.",
        f"2. Threshold: Only matches with similarity >= {results['summary']['threshold_used']}% are considered.",
        f"3. Amount Tolerance: Matched pairs must have amounts within {results['summary']['tolerance_used']}% "
        "(absolute values compared; bank outflows treated as positive for comparison).",
        "4. One-to-One Matching: Each invoice can match at most one bank transaction. "
        "Subsequent bank transactions matching the same invoice are flagged as 'Invoice Already Matched'.",
        "5. Categorization: Rule-based keyword mapping on bank description. Extend CATEGORY_MAP for custom rules.",
        "6. Currency: Amounts displayed as parsed. No FX conversion applied.",
        "7. This report is generated automatically. All matches should be verified by a qualified accountant "
        "before financial close.",
    ]
    for note in notes:
        pdf.multi_cell(0, 5, f"  {note}")
        pdf.ln(1)
    
    # Output
    pdf_path = f"recon_report_{datetime.now().strftime('%Y%m%d_%H%M%S')}.pdf"
    pdf.output(pdf_path)
    return pdf_path


